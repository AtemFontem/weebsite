{
  "name": "FullWashAndSet",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "pretty": "prettier --write \"src/*.ts\" \"src/**/*.{astro, ts, md}\"",
    "exif": "exiftool -all:all= -r -overwrite_original public/photolog/",
    "photolog": "npx tsx scripts/generate-photolog.ts",
    "blur": "bash scripts/blur.sh",
    "prep": "npm run photolog && npm run pretty",
    "photos": "bash scripts/prepare-photos.sh ~/Pictures/FullWashEdit && bash scripts/blur.sh && npx tsx scripts/generate-photolog.ts",
    "generate-types": "wrangler types"
  },
  "dependencies": {
    "@astrojs/check": "^0.3.4",
    "@astrojs/cloudflare": "^14.3.1",
    "astro": "^7.3.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.1.1",
    "prettier-plugin-astro": "^0.12.2",
    "tsx": "^4.15.6",
    "typescript": "^5.3.3",
    "wrangler": "^4.131.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260914.1",
    "@types/node": "^26.6.4"
  }
}
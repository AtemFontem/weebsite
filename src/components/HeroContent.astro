---
// src/components/HeroContent.astro
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';

const years = ['2026', '2025', '2024', '2023', '2022', '2021', 'all'];
---

<div class="hero-wrapper">
  <nav class="year-sidebar" aria-label="Year navigation" id="year-sidebar">
    {years.map((y) => (
      <a href={`${base}photolog/${y}`} data-year={y}>[{y}]</a>
    ))}
  </nav>

  <div class="main-content">
    <slot />
  </div>
</div>

<script>
  function updateHeroVisibility() {
    if (typeof window === "undefined") return;

    const path = window.location.pathname;

    const isPhotoView = path.startsWith("/photolog/view/");
    const isIndex = path === "/" || path === "";

    const showYearNav =
      isIndex ||
      (path.startsWith("/photolog/") && !isPhotoView);

    const yearSidebar = document.getElementById("year-sidebar");
    if (yearSidebar) {
      yearSidebar.classList.toggle("hidden", !showYearNav);
    }

    const yearLinks = document.querySelectorAll(".year-sidebar a[data-year]");
    const currentYearMatch = path.match(/\/photolog\/(\d+|all)\/?$/);
    const currentYear = currentYearMatch ? currentYearMatch[1] : null;

    yearLinks.forEach((link) => {
      const linkYear = link.getAttribute("data-year");
      if ((isIndex && linkYear === "all") || linkYear === currentYear) {
        link.classList.add("placeholder");
      } else {
        link.classList.remove("placeholder");
      }
    });
  }

  updateHeroVisibility();
  document.addEventListener("astro:page-load", updateHeroVisibility);
</script>

<style>
  .hero-wrapper {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 16px;
    box-sizing: border-box;
    position: relative;
  }

  .year-sidebar {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 10px;
    padding: 4px 0;
    border-bottom: 2px solid var(--text, #000);
    /* Small top margin to give a bit of air above the year row */
    margin-top: 4px;
    margin-bottom: 4px;
    width: 100%;
    box-sizing: border-box;
    position: sticky;
    top: 0;
    background-color: var(--background, #fff);
    z-index: 10;
    view-transition-name: none !important;
  }

  .year-sidebar.hidden {
    display: none;
  }

  .year-sidebar a {
    color: var(--link, #ff0000);
    text-decoration: none;
    white-space: nowrap;
    line-height: 1.2;
  }

  .year-sidebar a:hover { text-decoration: underline; }

  .year-sidebar a.placeholder {
    color: var(--text, #000);
    opacity: 0.3;
    cursor: default;
    pointer-events: none;
  }

  .main-content {
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    box-sizing: border-box;
  }

  @media only screen and (min-width: 1024px) {
    .hero-wrapper {
      padding: 0 24px;
    }

    .year-sidebar {
      flex-direction: column;
      justify-content: flex-start;
      gap: 12px;
      padding: 0;
      border-bottom: none;
      margin-top: 0;
      margin-bottom: 0;
      width: auto;
      min-width: 120px;
      position: fixed;
      top: 120px;
      right: 30px;
      background-color: transparent;
      z-index: 100;
    }

    .year-sidebar.hidden {
      display: none;
    }

    .year-sidebar a {
      font-size: 1.1em;
      padding: 4px 0;
      display: block;
      text-align: right;
    }

    .year-sidebar a.placeholder {
      color: var(--text, #000);
      opacity: 0.3;
      cursor: default;
      pointer-events: none;
    }
  }
</style>
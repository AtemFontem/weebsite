---
// src/components/HeroContent.astro
const base = import.meta.env.BASE_URL;

const years = ['2026', '2025', '2024', '2023', '2022', '2021', 'all'];
---

<div class="hero-wrapper">
  <nav class="year-sidebar" aria-label="Year navigation" id="year-sidebar">
    {years.map((y) => (
      <a href={`${base}photolog/${y}`} data-year={y}>[{y}]</a>
    ))}
  </nav>

  <div class="main-content">
    <div class="other-links" id="other-links">
      <a href="https://instagram.com/full_wash_and_set" target="_blank" id="link-instagram">[instagram]</a>
      <a href={`${base}guestbook`} id="link-guestbook">[guestbook]</a>
      <a href={`${base}about`} id="link-about">[about]</a>
      <a href="javascript:history.back()" class="go-back" id="link-goback" style="display: none;">[go back]</a>
    </div>
    <slot />
  </div>
</div>

<script>
  function updateHeroVisibility() {
    if (typeof window === "undefined") return;

    // Strip the base path so path matching still works
    const base = "/weebsite";
    const path = window.location.pathname.replace(base, "") || "/";

    const isGuestbook = path === "/guestbook";
    const isAbout = path === "/about";
    const isPhotoView = path.startsWith("/photolog/view/");
    const isIndex = path === "/";
    const isAllPage = path === "/photolog/all";

    const showYearNav =
      path === "/" ||
      (path.startsWith("/photolog/") && !isPhotoView);

    const yearSidebar = document.getElementById("year-sidebar");
    if (yearSidebar) {
      yearSidebar.classList.toggle("hidden", !showYearNav);
    }

    const linkInstagram = document.getElementById("link-instagram");
    const linkGuestbook = document.getElementById("link-guestbook");
    const linkAbout = document.getElementById("link-about");
    const linkGoBack = document.getElementById("link-goback");

    if (isPhotoView) {
      if (linkInstagram) linkInstagram.style.display = "none";
      if (linkGuestbook) linkGuestbook.style.display = "none";
      if (linkAbout) linkAbout.style.display = "none";
      if (linkGoBack) linkGoBack.style.display = "inline-block";
    } else {
      if (linkInstagram) linkInstagram.style.display = "inline-block";
      if (linkGuestbook) {
        linkGuestbook.style.display = "inline-block";
        linkGuestbook.className = isGuestbook ? "placeholder" : "";
      }
      if (linkAbout) {
        linkAbout.style.display = "inline-block";
        linkAbout.className = isAbout ? "placeholder" : "";
      }
      if (linkGoBack) linkGoBack.style.display = "none";
    }

    const yearLinks = document.querySelectorAll(
      ".year-sidebar a[data-year]"
    );
    const currentYearMatch = path.match(/\/photolog\/(\d+|all)$/);
    const currentYear = currentYearMatch ? currentYearMatch[1] : null;

    yearLinks.forEach((link) => {
      const linkYear = link.getAttribute("data-year");
      if ((isIndex && linkYear === "all") || linkYear === currentYear) {
        link.classList.add("placeholder");
      } else {
        link.classList.remove("placeholder");
      }
    });
  }

  updateHeroVisibility();
  document.addEventListener("astro:page-load", updateHeroVisibility);
</script>

<style>
  .hero-wrapper {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 16px;
    box-sizing: border-box;
    position: relative;
  }

  .year-sidebar {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 16px;
    padding: 12px 0;
    border-bottom: 2px solid var(--text, #000);
    margin-bottom: 16px;
    width: 100%;
    box-sizing: border-box;
    position: sticky;
    top: 0;
    background-color: var(--background, #fff);
    z-index: 10;
    order: 0;
    view-transition-name: none !important;
  }

  .year-sidebar.hidden {
    visibility: hidden;
    pointer-events: none;
    border-bottom-color: transparent;
  }

  .year-sidebar a {
    color: var(--link, #ff0000);
    text-decoration: none;
    white-space: nowrap;
  }

  .year-sidebar a:hover {
    text-decoration: underline;
  }

  .year-sidebar a.placeholder {
    color: var(--text, #000);
    opacity: 0.3;
    cursor: default;
    pointer-events: none;
  }

  .other-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    gap: 8px 20px;
    margin-bottom: 16px;
    box-sizing: border-box;
    view-transition-name: none !important;
  }

  .other-links a:nth-child(2),
  .other-links .placeholder:nth-child(2) {
    margin: 0 auto;
  }

  .other-links a,
  .other-links .placeholder,
  .other-links .go-back {
    display: inline-block;
    font-size: 16px;
    line-height: 1.5;
  }

  .other-links .placeholder {
    color: var(--text, #000);
    opacity: 0.3;
    cursor: default;
    pointer-events: none;
  }

  .other-links .go-back {
    color: var(--link, #ff0000);
    text-decoration: none;
  }

  .other-links .go-back:hover {
    text-decoration: underline;
  }

  .main-content {
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    box-sizing: border-box;
    order: 1;
  }

  @media only screen and (min-width: 1024px) {
    .hero-wrapper {
      flex-direction: column;
      padding: 0 24px;
    }

    .year-sidebar {
      flex-direction: column;
      justify-content: flex-start;
      gap: 12px;
      padding: 0;
      border-bottom: none;
      margin-bottom: 0;
      width: auto;
      min-width: 120px;
      position: fixed;
      top: 120px;
      right: 30px;
      background-color: transparent;
      z-index: 100;
      order: 0;
    }

    .year-sidebar.hidden {
      visibility: hidden;
      pointer-events: none;
    }

    .year-sidebar a {
      font-size: 1.1em;
      padding: 4px 0;
      display: block;
      text-align: right;
    }

    .year-sidebar a.placeholder {
      color: var(--text, #000);
      opacity: 0.3;
      cursor: default;
      pointer-events: none;
    }

    .main-content {
      order: 0;
      width: 100%;
      max-width: 800px;
      margin: 0 auto;
    }

    .other-links {
      max-width: 800px;
      margin: 0 auto;
      gap: 8px 24px;
    }
  }

  @media only screen and (max-width: 700px) {
    .year-sidebar {
      gap: 8px 12px;
    }

    .other-links {
      gap: 8px 12px;
      max-width: 100%;
    }

    .main-content {
      max-width: 100%;
    }
  }
</style>
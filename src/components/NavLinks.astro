---
// src/components/NavLinks.astro
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---

<div class="other-links" id="other-links">
  <a href="https://instagram.com/full_wash_and_set" target="_blank" id="link-instagram" class="link-left">[instagram]</a>
  <a href={`${base}guestbook`} id="link-guestbook" class="link-center">[guestbook]</a>
  <a href={`${base}about`} id="link-about" class="link-right">[about]</a>
  <a href="javascript:history.back()" class="go-back" id="link-goback" style="display: none;">[go back]</a>
</div>

<script>
  function updateNavVisibility() {
    if (typeof window === "undefined") return;

    const path = window.location.pathname;
    const isGuestbook = path === "/guestbook" || path === "/guestbook/";
    const isAbout = path === "/about" || path === "/about/";
    const isPhotoView = path.startsWith("/photolog/view/");

    const linkInstagram = document.getElementById("link-instagram");
    const linkGuestbook = document.getElementById("link-guestbook");
    const linkAbout = document.getElementById("link-about");
    const linkGoBack = document.getElementById("link-goback");

    if (isPhotoView) {
      if (linkInstagram) linkInstagram.style.display = "none";
      if (linkGuestbook) linkGuestbook.style.display = "none";
      if (linkAbout) linkAbout.style.display = "none";
      if (linkGoBack) linkGoBack.style.display = "block";
    } else {
      if (linkInstagram) linkInstagram.style.display = "block";
      if (linkGuestbook) {
        linkGuestbook.style.display = "block";
        linkGuestbook.className = isGuestbook ? "link-center placeholder" : "link-center";
      }
      if (linkAbout) {
        linkAbout.style.display = "block";
        linkAbout.className = isAbout ? "link-right placeholder" : "link-right";
      }
      if (linkGoBack) linkGoBack.style.display = "none";
    }
  }

  updateNavVisibility();
  document.addEventListener("astro:page-load", updateNavVisibility);
</script>

<style>
  /* ============================================================
     MOBILE: three-column grid = perfectly centered middle link
     ============================================================ */
  .other-links {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    gap: 0 6px;
    margin-bottom: 2px;
    box-sizing: border-box;
    view-transition-name: none !important;
  }

  .link-left {
    justify-self: start;
    text-align: left;
  }

  .link-center {
    justify-self: center;
    text-align: center;
  }

  .link-right {
    justify-self: end;
    text-align: right;
  }

  .other-links a,
  .other-links .placeholder,
  .other-links .go-back {
    display: block;
    font-size: 16px;
    line-height: 1.3;
  }

  .other-links .go-back {
    grid-column: 1 / -1;
    justify-self: start;
    color: var(--link, #ff0000);
    text-decoration: none;
  }

  .other-links .go-back:hover { text-decoration: underline; }

  .other-links .placeholder {
    color: var(--text, #000);
    opacity: 0.3;
    cursor: default;
    pointer-events: none;
  }

  /* ============================================================
     DESKTOP: revert to the previous flex layout
     ============================================================ */
  @media only screen and (min-width: 1024px) {
    .other-links {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 4px 20px;
      margin-bottom: 12px;
    }

    .link-left,
    .link-center,
    .link-right {
      justify-self: auto;
      text-align: initial;
    }

    .other-links a:nth-child(2),
    .other-links .placeholder:nth-child(2) {
      margin: 0 auto;
    }
  }
</style>
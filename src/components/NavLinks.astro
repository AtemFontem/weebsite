---
// src/components/NavLinks.astro
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---

<div class="other-links" id="other-links">
  <a href="https://instagram.com/full_wash_and_set" target="_blank" id="link-instagram" class="nav-link">[instagram]</a>
  <a href={`${base}guestbook`} id="link-guestbook" class="nav-link">[guestbook]</a>
  <a href={`${base}about`} id="link-about" class="nav-link">[about]</a>
  <a href="javascript:history.back()" class="go-back" id="link-goback" style="display: none;">[go back]</a>
</div>

<script>
  function updateNavVisibility() {
    if (typeof window === "undefined") return;

    const path = window.location.pathname;
    const isGuestbook = path === "/guestbook" || path === "/guestbook/";
    const isAbout = path === "/about" || path === "/about/";
    const isPhotoView = path.startsWith("/photolog/view/");

    const linkInstagram = document.getElementById("link-instagram");
    const linkGuestbook = document.getElementById("link-guestbook");
    const linkAbout = document.getElementById("link-about");
    const linkGoBack = document.getElementById("link-goback");

    if (isPhotoView) {
      if (linkInstagram) linkInstagram.style.display = "none";
      if (linkGuestbook) linkGuestbook.style.display = "none";
      if (linkAbout) linkAbout.style.display = "none";
      if (linkGoBack) linkGoBack.style.display = "inline";
    } else {
      if (linkInstagram) linkInstagram.style.display = "inline";
      if (linkGuestbook) {
        linkGuestbook.style.display = "inline";
        linkGuestbook.className = isGuestbook ? "nav-link placeholder" : "nav-link";
      }
      if (linkAbout) {
        linkAbout.style.display = "inline";
        linkAbout.className = isAbout ? "nav-link placeholder" : "nav-link";
      }
      if (linkGoBack) linkGoBack.style.display = "none";
    }
  }

  updateNavVisibility();
  document.addEventListener("astro:page-load", updateNavVisibility);
</script>

<style>
  /* ============================================================
     Mobile: equal gaps between links (space-around distributes
     space evenly on both sides of each item, so the visible
     whitespace between neighbors is identical)
     ============================================================ */
  @media only screen and (max-width: 1023px) {
    .other-links {
      width: calc(100% + 24px);
      max-width: calc(100% + 24px);
      margin-left: -12px;
      margin-right: -12px;
      padding: 0 16px;
      display: flex;
      justify-content: space-around;
      align-items: center;
      box-sizing: border-box;
    }
  }

  .other-links {
    display: flex;
    align-items: center;
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    margin-bottom: 2px;
    box-sizing: border-box;
    view-transition-name: none !important;
  }

  .nav-link {
    display: inline-block;
    font-size: 16px;
    line-height: 1.3;
    white-space: nowrap;
    text-decoration: none;
    color: var(--link, #ff0000);
    padding: 0;
    margin: 0;
  }

  .nav-link:hover { text-decoration: underline; }

  .nav-link.placeholder {
    color: var(--text, #000);
    opacity: 0.3;
    cursor: default;
    pointer-events: none;
  }

  .go-back {
    display: inline-block;
    font-size: 16px;
    line-height: 1.3;
    color: var(--link, #ff0000);
    text-decoration: none;
  }

  .go-back:hover { text-decoration: underline; }

  /* ============================================================
     Desktop: keep it in a row with space-between
     ============================================================ */
  @media only screen and (min-width: 1024px) {
    .other-links {
      justify-content: space-between;
      margin-bottom: 12px;
    }
  }
</style>
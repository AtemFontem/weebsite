---
// src/components/NavLinks.astro
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---

<div class="other-links" id="other-links">
  <a href="https://instagram.com/full_wash_and_set" target="_blank" id="link-instagram">[instagram]</a>
  <a href={`${base}guestbook`} id="link-guestbook">[guestbook]</a>
  <a href={`${base}about`} id="link-about">[about]</a>
  <a href="javascript:history.back()" class="go-back" id="link-goback" style="display: none;">[go back]</a>
</div>

<script>
  function updateNavVisibility() {
    if (typeof window === "undefined") return;

    const path = window.location.pathname;
    const isGuestbook = path === "/guestbook" || path === "/guestbook/";
    const isAbout = path === "/about" || path === "/about/";
    const isPhotoView = path.startsWith("/photolog/view/");

    const linkInstagram = document.getElementById("link-instagram");
    const linkGuestbook = document.getElementById("link-guestbook");
    const linkAbout = document.getElementById("link-about");
    const linkGoBack = document.getElementById("link-goback");

    if (isPhotoView) {
      if (linkInstagram) linkInstagram.style.display = "none";
      if (linkGuestbook) linkGuestbook.style.display = "none";
      if (linkAbout) linkAbout.style.display = "none";
      if (linkGoBack) linkGoBack.style.display = "inline-block";
    } else {
      if (linkInstagram) linkInstagram.style.display = "inline-block";
      if (linkGuestbook) {
        linkGuestbook.style.display = "inline-block";
        linkGuestbook.className = isGuestbook ? "placeholder" : "";
      }
      if (linkAbout) {
        linkAbout.style.display = "inline-block";
        linkAbout.className = isAbout ? "placeholder" : "";
      }
      if (linkGoBack) linkGoBack.style.display = "none";
    }
  }

  updateNavVisibility();
  document.addEventListener("astro:page-load", updateNavVisibility);
</script>

<style>
  .other-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    /* Tightened: was 6px 12px */
    gap: 0px 0px;
    /* Tightened: was 4px */
    margin-bottom: 2px;
    box-sizing: border-box;
    view-transition-name: none !important;
  }

  .other-links a:nth-child(2),
  .other-links .placeholder:nth-child(2) { margin: 0 auto; }

  .other-links a,
  .other-links .placeholder,
  .other-links .go-back {
    display: inline-block;
    font-size: 16px;
    /* Tightened line-height for less vertical air */
    line-height: 1.3;
  }

  .other-links .placeholder {
    color: var(--text, #000);
    opacity: 0.3;
    cursor: default;
    pointer-events: none;
  }

  .other-links .go-back {
    color: var(--link, #ff0000);
    text-decoration: none;
  }

  .other-links .go-back:hover { text-decoration: underline; }

  @media only screen and (min-width: 1024px) {
    .other-links {
      /* Desktop can breathe a bit more */
      gap: 4px 20px;
      margin-bottom: 12px;
    }
  }
</style>
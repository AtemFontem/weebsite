---
// this only runs when the site is built
// github pages servers always set the date a day ahead of when i push
// timezones are evil
const day = 24 * 60 * 60 * 1000;
const today = new Date(Date.now() - day);

const formatDate = (date: Date) => {
  const year = date.getFullYear();
  const month =
    date.getMonth() + 1 > 9
      ? `${date.getMonth() + 1}`
      : `0${date.getMonth() + 1}`;
  const day = date.getDate() > 9 ? `${date.getDate()}` : `0${date.getDate()}`;

  return `${year}-${month}-${day}`;
};
---

<script>
  const RESTORE_SCROLL_KEY = "RESTORE_SCROLL_KEY";
  const SLUGS = ["2023", "2022", "2021", "all"];

  const header = document.getElementById("title");

  // don't restore scroll if we were previously on a year page
  window.addEventListener("load", () => {
    const slug = new URL(document.referrer).pathname.match(/[^\/]+/g);
    if (slug && slug.length > 0 && SLUGS.includes(slug[slug.length - 1])) {
      window.sessionStorage.setItem(RESTORE_SCROLL_KEY, "2");
    }
  });
</script>
<header>
  <h1 id="top"><a href="/" id="title" }>aymenis.online</a></h1>
  <p>last updated: {formatDate(today)}</p>
</header>

<style>
  header {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  h1 {
    margin-bottom: 0;
  }

  p {
    margin: 0;
  }

  @media only screen and (max-width: 700px) {
    header {
      text-align: center;
    }
  }
</style>

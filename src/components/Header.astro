---
// src/components/Header.astro
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---

<header>
  <h1 id="top">
    <a href={base} id="title" class="animated-title">full wash and set</a>
  </h1>
</header>

<style>
  header {
    display: flex;
    flex-direction: column;
    gap: 0;
    align-items: center;
    width: 100%;
    box-sizing: border-box;
    padding: 0 4px;
  }

  h1 {
    margin-bottom: 0;
    width: 100%;
    text-align: center;
    word-break: break-word;
  }

  .animated-title {
    /* Custom hollow font */
    font-family: 'Times Roman Hollow bold', 'Times New Roman', Times, serif !important;
    font-size: 48px;
    font-weight: normal;

    /* Animated background image */
    background-image: url('/site-images/postGridEdit.png');
    background-size: 200px 200px;
    background-repeat: repeat;

    background-clip: text;
    -webkit-background-clip: text;
    color: transparent !important;
    text-decoration: none;

    /* ============================================================
       SEAMLESS SOUTHEAST SCROLL
       Travel exactly one tile diagonally (200px in both axes).
       Since both distances equal the tile size, the loop is
       invisible — the background at 100% is identical to 0%.
       ============================================================ */
    animation: scrollSoutheast 30s linear infinite;
    will-change: background-position;
    backface-visibility: hidden;

    display: inline-block;
    /* No horizontal stretch — removed scaleX(1.4) */
  }

  /* Background appears to travel southeast (top-left → bottom-right) */
  @keyframes scrollSoutheast {
    0% {
      background-position: 0 0;
    }
    100% {
      background-position: 200px 200px;
    }
  }

  .animated-title:hover {
    animation-play-state: running;
  }

  @supports not (background-clip: text) {
    .animated-title {
      color: #800080 !important;
      background-image: none !important;
      background-clip: unset !important;
      -webkit-background-clip: unset !important;
    }
  }

  @media only screen and (max-width: 700px) {
    .animated-title {
      font-size: 45px;
    }
  }
</style>
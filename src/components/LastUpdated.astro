---
// src/components/LastUpdated.astro
const day = 24 * 60 * 60 * 1000;
const today = new Date(Date.now() - day);

const formatDate = (date: Date) => {
  const months = ['jan', 'feb', 'mar', 'apr', 'may', 'jun', 
                  'jul', 'aug', 'sep', 'oct', 'nov', 'dec'];
  const month = months[date.getMonth()];
  const day = date.getDate();
  const year = date.getFullYear();
  return `${month} ${day} ${year}`;
};

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';

const rawPath = Astro.url.pathname;
const currentPath =
  base !== '/' && rawPath.startsWith(base)
    ? rawPath.slice(base.length - 1) || '/'
    : rawPath;

const currentYear = String(new Date().getFullYear());

const yearMatch = currentPath.match(/^\/photolog\/(\d{4})\/?$/);
const isCurrentYearPage = yearMatch !== null && yearMatch[1] === currentYear;

const showLastUpdated =
  currentPath === '/' ||
  currentPath === '/photolog/all' ||
  currentPath === '/photolog/all/' ||
  isCurrentYearPage;
---

{showLastUpdated && (
  <p class="updated">
    last updated: {formatDate(today)}
  </p>
)}

<style>
  p.updated {
    margin: 0;
    width: 100%;
    display: block;
    line-height: 1.2;
    text-align: left;
    padding-left: 4px;
    margin-bottom: 2px;
  }

  @media only screen and (max-width: 700px) {
    p.updated {
      text-align: center;
      padding: 0 4px;
      line-height: 1.2;
      margin-bottom: 2px;
    }
  }
</style>
---
// src/components/Footer.astro

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';

const rawPath = Astro.url.pathname;
const pathWithoutBase =
  base !== '/' && rawPath.startsWith(base)
    ? rawPath.slice(base.length - 1) || '/'
    : rawPath;

const currentPath =
  pathWithoutBase.length > 1 && pathWithoutBase.endsWith('/')
    ? pathWithoutBase.slice(0, -1)
    : pathWithoutBase;

// Show "top" link only on index and /photolog/all
const showTopLink = currentPath === '/' || currentPath === '/photolog/all';

// Show Bob's Club section only on about page
const showBobsClub = currentPath === '/about';
---

<footer class={showBobsClub ? 'footer-about' : ''}>
  {showTopLink && (
    <a href="#top">top</a>
  )}

  {showBobsClub && (
    <>
      <div class="bobs-club">
        this website is a member of <a href="https://bobs-club.net/" target="_blank">[bob's club]</a>.<br />
        <a href="https://bobs-club.net/site/adrawr/pred" target="_blank">[&lt;&lt;]</a>&emsp;
        <a href="https://bobs-club.net/site/adrawr/random" target="_blank">[**]</a>&emsp;
        <a href="https://bobs-club.net/site/adrawr/succ" target="_blank">[&gt;&gt;]</a>
      </div>
    </>
  )}
</footer>

<style>
  footer {
    text-align: center;
    padding: 20px 0;
  }

  /* ============================================================
     About page: push the footer toward the bottom of the viewport,
     leaving ~30px of clearance for the iPhone home bar.
     ============================================================ */
  .footer-about {
    margin-top: auto;
    padding-bottom: 30px;
    padding-top: 20px;
  }
</style>
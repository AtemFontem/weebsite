---
import { extractYear, extractFileName, photos } from "../photolog-utils";

type Props = {
  year?: number;
};

const { year } = Astro.props;

const makeItThree = (arr: string[]) => {
  const newArr = [];

  let lastTriplet = 0;
  for (let i = 0; i < arr.length; i++) {
    if (i > 0 && i % 3 == 0) {
      newArr.push([arr[i - 3], arr[i - 2], arr[i - 1]]);
      lastTriplet = i;
    }
  }

  return [...newArr, [...arr.slice(lastTriplet)]];
};

const filteredByYear = photos.filter((photo) =>
  year ? extractYear(photo) === year : true,
);

const tripletedFileNames = makeItThree(filteredByYear);
---

<script>
  const scrollKey = "SCROLL";

  const saveScrollPositionToSessionStorage = () =>
    window.sessionStorage.setItem(scrollKey, String(window.scrollY));

  window.addEventListener("pageshow", () => {
    // avoid saving scroll position while we're restoring the old one
    window.removeEventListener("scroll", saveScrollPositionToSessionStorage);
    // retrieve from sessionStorage
    const y = Number(sessionStorage.getItem(scrollKey)) || 0;

    // to check if we're stuck trying to scroll somewhere unreachable
    let prevY = -1;

    const restoreScroll = () => {
      setTimeout(() => {
        // break if we've restored position or are stuck
        if (window.scrollY >= y || window.scrollY == prevY) {
          // we can start saving scroll positions again
          window.addEventListener("scroll", saveScrollPositionToSessionStorage);
          return;
        }
        window.scrollTo(0, y);
        prevY = window.scrollY;
        restoreScroll();
      }, 400);
    };

    restoreScroll();
  });
</script>

<div class="column">
  {
    tripletedFileNames.map((triplet) => (
      <div class="row">
        {triplet.map((photoSrc) => (
          <div class="img-container">
            <a
              href={`/photolog/view/${extractYear(photoSrc)}-${extractFileName(
                photoSrc,
              )}`}
            >
              <img src={photoSrc} loading="lazy" />
            </a>
          </div>
        ))}
      </div>
    ))
  }
</div>

<style>
  .column {
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding: 24px;
    margin: 0px 10%;
  }

  .row {
    display: flex;
    padding: 0px 20px;
    width: 100%;
    height: 100%;
    gap: 48px;
  }

  .img-container {
    width: 100%;
  }

  img {
    max-width: 100%;
    max-height: 100%;
  }

  @media only screen and (max-width: 700px) {
    .row {
      flex-direction: column;
      gap: 12px;
      flex: 100%;
      padding: 0;
    }

    .column {
      gap: 12px;
      margin: 0;
      padding: 0;
    }

    .img-container {
      display: flex;
      justify-content: center;
      align-items: center;
    }
  }
</style>

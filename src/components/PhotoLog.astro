---
// src/components/PhotoLog.astro
import { extractYear, extractFileName } from "../photolog-utils";
import { LOADING_SPINNER_URL } from "../loading-spinner";
import { photos } from "../photolog";

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';

type Props = {
  year?: number;
  layout?: 'grid' | 'single';
};

const { year, layout = 'grid' } = Astro.props;

const filteredByYear = photos.filter((photo) =>
  year ? extractYear(photo.sq) === year : true,
);
---

<script>
  const SCROLL_KEY = "SCROLL";
  const RESTORE_SCROLL_KEY = "RESTORE_SCROLL_KEY";
  const TWO_MINUTES = 2 * 60 * 1000;
  const FIRST_TIMEOUT = 100;
  const TIMEOUT = 600;

  const isYearPageSlug = (slug: any) => {
    const SLUGS = ["2024", "2023", "2022", "2021", "all"];
    return slug && slug.length > 0 && SLUGS.includes(slug[slug.length - 1]);
  };

  const saveScrollPositionToSessionStorage = () => {
    setTimeout(
      () =>
        window.sessionStorage.setItem(
          SCROLL_KEY,
          JSON.stringify({
            y: window.scrollY,
            timestamp: new Date().toISOString(),
          }),
        ),
      TIMEOUT,
    );
  };

  window.addEventListener("pageshow", () => {
    const now = new Date();
    window.removeEventListener("scroll", saveScrollPositionToSessionStorage);
    const { y, timestamp } = JSON.parse(
      sessionStorage.getItem(SCROLL_KEY) ??
        JSON.stringify({ y: 0, timestamp: now }),
    );
    const shouldRestoreScroll = parseInt(
      window.sessionStorage.getItem(RESTORE_SCROLL_KEY) ?? "0",
    );
    window.sessionStorage.setItem(RESTORE_SCROLL_KEY, "0");

    let prevY = -1;
    let firstTime = true;

    const restoreScroll = () => {
      setTimeout(
        () => {
          if (window.scrollY >= y || window.scrollY == prevY) {
            window.addEventListener("scroll", saveScrollPositionToSessionStorage);
            return;
          }
          window.scrollTo(0, y);
          prevY = window.scrollY;
          firstTime = false;
          restoreScroll();
        },
        firstTime ? FIRST_TIMEOUT : TIMEOUT,
      );
    };

    const currentPageSlug = new URL(window.location.href).pathname.match(/[^\/]+/g);

    if (
      now.valueOf() - new Date(timestamp).valueOf() < TWO_MINUTES &&
      (shouldRestoreScroll === 1 ||
        (shouldRestoreScroll === 2 && isYearPageSlug(currentPageSlug)))
    ) {
      restoreScroll();
    } else {
      window.addEventListener("scroll", saveScrollPositionToSessionStorage);
    }
  });
</script>

<div class={`grid ${layout === 'single' ? 'single-column' : ''}`}>
  {
    filteredByYear.map((photoObj) => {
      const photoSrc = photoObj.sq;
      const cleanSrc = photoSrc.replace(/^\//, '');
      return (
        <a
          class="img-container"
          href={`${base}photolog/view/${extractYear(photoSrc)}-${extractFileName(photoSrc)}`}
        >
          <img
            loading="lazy"
            src={`${base}${cleanSrc}`}
            style={`background-image: url("${LOADING_SPINNER_URL}"); background-repeat: no-repeat; background-size: 40px; background-position: center;`}
          />
        </a>
      );
    })
  }
</div>

<style>
  .grid {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    gap: 24px;
    margin: 0 10%;
    margin-top: 20px;
  }

  .img-container {
    display: block;
    flex: 0 1 auto;
    width: 200px;
    max-width: 100%;
    border: 10px solid #0000ff;
    border-radius: 0;
    overflow: hidden;
    box-sizing: border-box;
    line-height: 0;
  }

  img {
    width: 100%;
    height: auto;
    display: block;
  }

  .grid.single-column {
    gap: 32px;
    margin: 0 auto;
    max-width: 600px;
  }

  .grid.single-column .img-container {
    width: 100% !important;
    max-width: 100% !important;
    flex: 1 0 100% !important;
    border-width: 12px;
    border-radius: 0;
  }

  @media only screen and (min-width: 1600px) {
    .img-container { width: 180px; }
    .grid { gap: 20px; margin: 0 6%; margin-top: 20px; }
  }

  @media only screen and (min-width: 1200px) and (max-width: 1599px) {
    .img-container { width: 190px; }
    .grid { gap: 20px; margin: 0 4%; margin-top: 20px; }
  }

  @media only screen and (min-width: 1024px) and (max-width: 1199px) {
    .img-container { width: 200px; }
    .grid { gap: 18px; margin: 0 3%; margin-top: 20px; }
  }

  @media only screen and (min-width: 768px) and (max-width: 1023px) {
    .img-container { width: 180px; }
    .grid { gap: 16px; margin: 0 2%; margin-top: 16px; }
  }

  @media only screen and (min-width: 500px) and (max-width: 767px) {
    .img-container { width: 160px; }
    .grid { gap: 14px; margin: 0 1%; margin-top: 12px; }
  }

  @media only screen and (max-width: 499px) {
    .grid { gap: 10px; margin: 0; padding: 0 6px; margin-top: 8px; }
    .img-container { width: 46% !important; flex: 1 0 auto !important; border-width: 6px; border-radius: 0; }
    .grid.single-column { gap: 24px !important; padding: 0 16px !important; max-width: 100% !important; }
    .grid.single-column .img-container {
      width: 100% !important;
      max-width: 500px !important;
      flex: 1 0 100% !important;
      border-width: 10px !important;
      border-radius: 0 !important;
      margin: 0 auto !important;
    }
  }

  @media only screen and (max-width: 350px) {
    .img-container { width: 92% !important; flex: 1 0 auto !important; border-width: 6px; border-radius: 0; }
    .grid { gap: 14px; }
    .grid.single-column .img-container { width: 100% !important; max-width: 350px !important; border-width: 8px !important; border-radius: 0 !important; }
    .grid.single-column { gap: 20px !important; padding: 0 12px !important; }
  }
</style>
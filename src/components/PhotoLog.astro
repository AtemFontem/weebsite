---
import { extractYear, extractFileName, photos } from "../photolog-utils";

type Props = {
  year?: number;
};

const { year } = Astro.props;

const emptyImgSrc = "EMPTY";

const makeItThree = (arr: string[]) => {
  const newArr = [];

  let lastTriplet = 0;
  for (let i = 0; i < arr.length; i++) {
    if (i > 0 && i % 3 == 0) {
      newArr.push([arr[i - 3], arr[i - 2], arr[i - 1]]);
      lastTriplet = i;
    }
  }

  const rest = arr.slice(lastTriplet);
  let newRest: string[] = [];
  switch (rest.length) {
    case 1:
      newRest = [rest[0], emptyImgSrc, emptyImgSrc];
      break;
    case 2:
      newRest = [rest[0], rest[1], emptyImgSrc];
      break;
    case 3:
      newRest = [rest[0], rest[1], rest[2]];
      break;
  }

  return [...newArr, newRest];
};

const filteredByYear = photos.filter((photo) =>
  year ? extractYear(photo) === year : true,
);

// const tripletedFileNames = makeItThree(filteredByYear);
---

<script>
  const SCROLL_KEY = "SCROLL";
  const RESTORE_SCROLL_KEY = "RESTORE_SCROLL_KEY";
  const TWO_MINUTES = 2 * 60 * 1000;
  const FIRST_TIMEOUT = 100;
  const TIMEOUT = 600;

  const isYearPageSlug = (slug: any) => {
    const SLUGS = ["2023", "2022", "2021", "all"];
    return slug && slug.length > 0 && SLUGS.includes(slug[slug.length - 1]);
  };

  const saveScrollPositionToSessionStorage = () => {
    setTimeout(
      () =>
        window.sessionStorage.setItem(
          SCROLL_KEY,
          JSON.stringify({
            y: window.scrollY,
            timestamp: new Date().toISOString(),
          }),
        ),
      TIMEOUT,
    );
  };

  window.addEventListener("pageshow", () => {
    const now = new Date();

    // avoid saving scroll position while we're restoring the old one
    window.removeEventListener("scroll", saveScrollPositionToSessionStorage);

    // retrieve from sessionStorage
    const { y, timestamp } = JSON.parse(
      sessionStorage.getItem(SCROLL_KEY) ??
        JSON.stringify({
          y: 0,
          timestamp: now,
        }),
    );
    const shouldRestoreScroll = parseInt(
      window.sessionStorage.getItem(RESTORE_SCROLL_KEY) ?? "0",
    );

    // don't restore scroll pos unless we're combing back from a view page
    window.sessionStorage.setItem(RESTORE_SCROLL_KEY, "0");

    // to check if we're stuck trying to scroll somewhere unreachable
    let prevY = -1;

    let firstTime = true;

    const restoreScroll = () => {
      setTimeout(
        () => {
          // break if we've restored position or are stuck
          if (window.scrollY >= y || window.scrollY == prevY) {
            // we can start saving scroll positions again
            window.addEventListener(
              "scroll",
              saveScrollPositionToSessionStorage,
            );
            return;
          }
          window.scrollTo(0, y);
          prevY = window.scrollY;
          firstTime = false;

          restoreScroll();
        },
        firstTime ? FIRST_TIMEOUT : TIMEOUT,
      );
    };

    const currentPageSlug = new URL(window.location.href).pathname.match(/[^\/]+/g);
    // 2: restore only if current slug is not "/"
    // 1: restore
    // 0: don't restore
    if (
      now.valueOf() - new Date(timestamp).valueOf() < TWO_MINUTES &&
      (shouldRestoreScroll === 1 ||
        (shouldRestoreScroll === 2 && isYearPageSlug(currentPageSlug)))
    ) {
      restoreScroll();
    } else {
      window.addEventListener("scroll", saveScrollPositionToSessionStorage);
    }
  });
</script>

<div class="column">
  {
    filteredByYear.map((photoSrc) => (
      <div class="img-container">
        <a
          href={
            photoSrc === emptyImgSrc
              ? "javascript:void(0)"
              : `/photolog/view/${extractYear(photoSrc)}-${extractFileName(
                  photoSrc,
                )}`
          }
        >
          {photoSrc !== emptyImgSrc && <img src={photoSrc} loading="lazy" />}
        </a>
      </div>
    ))
  }
</div>

<style>
  .column {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 48px;
    margin: 0px 10%;
  }

  .img-container {
    flex: 0 0 250px;
  }

  img {
    max-width: 100%;
  }

  @media only screen and (max-width: 800px) {
    .column {
      gap: 12px;
      margin: 0;
      padding: 0;
    }

    .column > * {
      flex: 1 0 40%;
    }
  }
</style>

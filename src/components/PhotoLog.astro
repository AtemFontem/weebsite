---
import { generateImageSrcForYear } from "../photolog-metadata";

type Props = {
  year?: number;
};

const { year } = Astro.props;

const extractFileName = (str: string) => {
  const extensionIncluded = /\d+.jpeg/g.exec(str)?.[0] ?? "0";
  return Number(extensionIncluded.substring(0, extensionIncluded.indexOf(".")));
};

const extractYear = (str: string) => {
  const fileNameIncluded = /\d*\/\d*.jpeg/g.exec(str)?.[0] ?? "0";
  return Number(fileNameIncluded.substring(0, fileNameIncluded.indexOf("/")));
};

const makeItThree = (arr: any[]) => {
  const newArr = [];

  let lastTriplet = 0;
  for (let i = 0; i < arr.length; i++) {
    if (i > 0 && i % 3 == 0) {
      newArr.push([arr[i - 3], arr[i - 2], arr[i - 1]]);
      lastTriplet = i;
    }
  }

  return [...newArr, [...arr.slice(lastTriplet)]];
};

const photos = [
  ...generateImageSrcForYear("2023"),
  ...generateImageSrcForYear("2022"),
  ...generateImageSrcForYear("2021"),
];

const filteredByYear = photos.filter((photo) =>
  year ? extractYear(photo) === year : true,
);
const tripletedFileNames = makeItThree(filteredByYear);
---

<div class="column">
  {
    tripletedFileNames.map((triplet) => (
      <div class="row">
        {triplet.map((photoSrc) => (
          <div class="img-container">
            <img src={photoSrc} />
          </div>
        ))}
      </div>
    ))
  }
</div>

<style>
  .column {
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding: 24px;
    margin: 0px 10%;
  }

  .row {
    display: flex;
    padding: 0px 20px;
    width: 100%;
    height: 100%;
    gap: 48px;
  }

  .img-container {
    width: 100%;
  }

  img {
    max-width: 100%;
    max-height: 100%;
  }

  @media only screen and (max-width: 700px) {
    .row {
      flex-direction: column;
      gap: 12px;
      flex: 100%;
      padding: 0;
    }

    .column {
      gap: 12px;
      margin: 0;
      padding: 0;
    }

    .img-container {
      display: flex;
      justify-content: center;
      align-items: center;
    }
  }
</style>

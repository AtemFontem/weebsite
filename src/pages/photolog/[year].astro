---
// src/pages/photolog/[year].astro
export const prerender = true;

import FooteredLayout from "../../layouts/FooteredLayout.astro";
import PhotoLog from "../../components/PhotoLog.astro";
import { PhotoLogMetadata } from "../../photolog-utils.ts";

export async function getStaticPaths() {
  const years = Object.keys(PhotoLogMetadata);
  return [...years, 'all'].map(year => ({
    params: { year }
  }));
}

const { year } = Astro.params;
const yearNum = year === 'all' ? undefined : parseInt(year);
---

<FooteredLayout title={`Photo Archive - ${year}`}>
  <main>
    <PhotoLog year={yearNum} layout="grid" />
  </main>
</FooteredLayout>
---
import Layout from "../../../layouts/Layout.astro";
import { extractYear, extractFileName, photos } from "../../../photolog-utils";

export function getStaticPaths() {
  return photos.map((photoSrc) => {
    return {
      params: { year: extractYear(photoSrc), index: extractFileName(photoSrc) },
    };
  });
}

const { year, index } = Astro.params;
const imageSrc = `/photolog/${year}/${index}.jpeg`;
---

<script>
  const RESTORE_SCROLL_KEY = "RESTORE_SCROLL_KEY";

  // restore scroll because we're coming back from a view page
  window.addEventListener("beforeunload", () => {
    window.sessionStorage.setItem(RESTORE_SCROLL_KEY, "1");
  });
</script>

<Layout>
  <div class="img-container">
    <img src={imageSrc} />
  </div>
</Layout>

<style>
  .img-container {
    display: flex;
    justify-content: center;
  }

  img {
    width: 60%;
  }

  @media only screen and (max-width: 700px) {
    img {
      width: 100%;
    }
  }
</style>

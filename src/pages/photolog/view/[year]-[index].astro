---
import Layout from "../../../layouts/Layout.astro";
import {
  extractYear,
  extractFileName,
  photos,
  rands,
} from "../../../photolog-utils";

export function getStaticPaths() {
  return photos.map((photoSrc) => {
    return {
      params: { year: extractYear(photoSrc), index: extractFileName(photoSrc) },
    };
  });
}

const { year, index } = Astro.params;
const imageSrc = `/photolog/${year}/${index}.jpeg`;

const indexOfCurr = photos.indexOf(imageSrc);

const prevImageSrc = indexOfCurr - 1 > -1 ? photos[indexOfCurr - 1] : null;
const prevYear = prevImageSrc ? extractYear(prevImageSrc) : "";
const prevFileName = prevImageSrc ? extractFileName(prevImageSrc) : "";
const prevImageHref = `/photolog/view/${prevYear}-${prevFileName}`;

const randomImageSrc = photos[rands[indexOfCurr]];
const randomYear = randomImageSrc ? extractYear(randomImageSrc) : "";
const randomFileName = randomImageSrc ? extractFileName(randomImageSrc) : "";
const randomImageHref = `/photolog/view/${randomYear}-${randomFileName}`;

const nextImageSrc =
  indexOfCurr + 1 < photos.length ? photos[indexOfCurr + 1] : null;
const nextYear = nextImageSrc ? extractYear(nextImageSrc) : "";
const nextFileName = nextImageSrc ? extractFileName(nextImageSrc) : "";
const nextImageHref = `/photolog/view/${nextYear}-${nextFileName}`;
---

<script>
  const RESTORE_SCROLL_KEY = "RESTORE_SCROLL_KEY";

  // restore scroll because we're coming back from a view page
  window.addEventListener("pagehide", () => {
    const shouldRestoreScroll = parseInt(
      window.sessionStorage.getItem(RESTORE_SCROLL_KEY) ?? "0",
    );
    if (shouldRestoreScroll === 0) {
      window.sessionStorage.setItem(RESTORE_SCROLL_KEY, "1");
    }
  });

// Where el is the DOM element you'd like to test for visibility
  const isHidden = (el: any) => {
    const style = window.getComputedStyle(el);
    return (style.visibility === 'hidden')
  }

  window.addEventListener("keydown", (e) => {
    const prevButton = document.getElementById("prev")
    const nextButton = document.getElementById("next")
    const randButton = document.getElementById("rand")

    switch(e.key) {
      case "ArrowRight":
      case "l":
        if (!isHidden(nextButton))
          nextButton?.click();
        break;
      case "ArrowLeft":
      case "h":
        if (!isHidden(prevButton))
          prevButton?.click();
        break;
      case "*":
        randButton?.click();
        break;
      default:
        break;
    }
  })

</script>

<Layout>
  <div class="container">
    <div class="nav-container">
      <p style={prevImageSrc == null ? "visibility: hidden" : ""}>
        <a id="prev" href={prevImageHref}>[<<]</a>
      </p>
      <p><a id="rand" href={randomImageHref}>[**]</a></p>
      <p style={nextImageSrc == null ? "visibility: hidden" : ""}>
        <a id="next" href={nextImageHref}>[>>]</a>
      </p>
    </div>
    <img src={imageSrc} />
  </div>
</Layout>

<style>
  .container {
    display: flex;
    flex-direction: column;
    gap: 24px;
    align-items: center;
    justify-content: center;
    padding-bottom: 72px;
  }

  .nav-container {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    width: 400px;
  }

  p {
    font-family: bold;
  }

  img {
    max-height: 700px;
  }

  @media only screen and (max-width: 700px) {
    .container {
      height: auto;
    }

    img {
      max-width: 100%;
      height: auto;
    }

    .nav-container {
      width: 80%;
    }
  }
</style>

---
import Layout from "../../../layouts/Layout.astro";
import {
  extractYear,
  extractFileName,
  photos,
  rands,
} from "../../../photolog-utils";

export function getStaticPaths() {
  return photos.map((photoObj) => {
    const photoSrc = photoObj.sq;
    return {
      params: { year: extractYear(photoSrc), index: extractFileName(photoSrc) },
    };
  });
}

const { year, index } = Astro.params;
// blur src
const imageSrcBlur = `/photolog/blur/${year}/${index}.jpeg`;
// photolog src
const imageSrc = `/photolog/sq/${year}/${index}.jpeg`;
// use high quality images for the view pages
const imageSrcHQ = `/photolog/hq/${year}/${index}.jpeg`;

const photosSq = photos.map((photoObj) => photoObj.sq);
const indexOfCurr = photosSq.indexOf(imageSrc);

const prevImageSrc = indexOfCurr - 1 > -1 ? photosSq[indexOfCurr - 1] : null;
const prevYear = prevImageSrc ? extractYear(prevImageSrc) : "";
const prevFileName = prevImageSrc ? extractFileName(prevImageSrc) : "";
const prevImageHref = `/photolog/view/${prevYear}-${prevFileName}`;

const randomImageSrc = photosSq[rands[indexOfCurr]];
const randomYear = randomImageSrc ? extractYear(randomImageSrc) : "";
const randomFileName = randomImageSrc ? extractFileName(randomImageSrc) : "";
const randomImageHref = `/photolog/view/${randomYear}-${randomFileName}`;

const nextImageSrc =
  indexOfCurr + 1 < photosSq.length ? photosSq[indexOfCurr + 1] : null;
const nextYear = nextImageSrc ? extractYear(nextImageSrc) : "";
const nextFileName = nextImageSrc ? extractFileName(nextImageSrc) : "";
const nextImageHref = `/photolog/view/${nextYear}-${nextFileName}`;
---

<script>
  const RESTORE_SCROLL_KEY = "RESTORE_SCROLL_KEY";

  const isYearPageSlug = (slug: any) => {
    const SLUGS = ["2023", "2022", "2021", "all"];
    return slug && slug.length > 0 && SLUGS.includes(slug[slug.length - 1]);
  };

  // restore scroll because we're coming back from a view page
  window.addEventListener("pagehide", () => {
    const shouldRestoreScroll = parseInt(
      window.sessionStorage.getItem(RESTORE_SCROLL_KEY) ?? "0",
    );
    const previousPageSlug = new URL(document.referrer).pathname.match(
      /[^\/]+/g,
    );

    // base state
    if (shouldRestoreScroll === 0) {
      window.sessionStorage.setItem(RESTORE_SCROLL_KEY, "1");
    }

    // if previous page was a year page
    if (isYearPageSlug(previousPageSlug)) {
      window.sessionStorage.setItem(RESTORE_SCROLL_KEY, "2");
    }
  });

  // Where el is the DOM element you'd like to test for visibility
  const isHidden = (el: any) => {
    const style = window.getComputedStyle(el);
    return style.visibility === "hidden";
  };

  window.addEventListener("keydown", (e) => {
    const prevButton = document.getElementById("prev");
    const nextButton = document.getElementById("next");
    const randButton = document.getElementById("rand");

    switch (e.key) {
      case "ArrowRight":
      case "l":
        if (!isHidden(nextButton)) nextButton?.click();
        break;
      case "ArrowLeft":
      case "h":
        if (!isHidden(prevButton)) prevButton?.click();
        break;
      case "*":
        randButton?.click();
        break;
      default:
        break;
    }
  });
</script>

<Layout>
  <div class="container">
    <div class="nav-container">
      <p style={prevImageSrc == null ? "visibility: hidden" : ""}>
        <a id="prev" href={prevImageHref}>[<<]</a>
      </p>
      <p><a id="rand" href={randomImageHref}>[**]</a></p>
      <p style={nextImageSrc == null ? "visibility: hidden" : ""}>
        <a id="next" href={nextImageHref}>[>>]</a>
      </p>
    </div>
    <div class="stack">
      <img src={imageSrcBlur} class="blur" />
      <img src={imageSrcHQ} />
    </div>
  </div>
</Layout>

<style>
  .container {
    display: flex;
    flex-direction: column;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 24px;
    padding-bottom: 72px;
  }

  .nav-container {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    width: 400px;
  }

  .stack {
    display: grid;
    grid-template-columns: 1fr;
    justify-items: center;
    align-items: center;
    > * {
      grid-area: 1 / 1;
    }
  }

  .blur {
    filter: blur(200);
    width: 100%;
  }

  img {
    max-height: 600px;
    max-width: 100%;
  }

  p {
    font-family: bold;
  }

  @media only screen and (max-width: 700px) {
    .container {
      height: auto;
    }

    img {
      max-height: 500px;
    }

    .nav-container {
      width: 80%;
    }
  }
</style>

---
import Layout from "../../../layouts/Layout.astro";
import { extractYear, extractFileName, photos } from "../../../photolog-utils";

export function getStaticPaths() {
  return photos.map((photoSrc) => {
    return {
      params: { year: extractYear(photoSrc), index: extractFileName(photoSrc) },
    };
  });
}

const getRandomInt = (max: number) => Math.floor(Math.random() * max);

const { year, index } = Astro.params;
const imageSrc = `/photolog/${year}/${index}.jpeg`;

const indexOfCurr = photos.indexOf(imageSrc);

const prevImageSrc = indexOfCurr - 1 > -1 ? photos[indexOfCurr - 1] : null;
const prevYear = prevImageSrc ? extractYear(prevImageSrc) : "";
const prevFileName = prevImageSrc ? extractFileName(prevImageSrc) : "";
const prevImageHref = `/photolog/view/${prevYear}-${prevFileName}`;

const randomImageSrc = photos[getRandomInt(photos.length)];
const randomYear = randomImageSrc ? extractYear(randomImageSrc) : "";
const randomFileName = randomImageSrc ? extractFileName(randomImageSrc) : "";
const randomImageHref = `/photolog/view/${randomYear}-${randomFileName}`;

const nextImageSrc =
  indexOfCurr + 1 < photos.length ? photos[indexOfCurr + 1] : null;
const nextYear = nextImageSrc ? extractYear(nextImageSrc) : "";
const nextFileName = nextImageSrc ? extractFileName(nextImageSrc) : "";
const nextImageHref = `/photolog/view/${nextYear}-${nextFileName}`;
---

<script>
  const RESTORE_SCROLL_KEY = "RESTORE_SCROLL_KEY";

  // restore scroll because we're coming back from a view page
  window.addEventListener("pagehide", () => {
    const shouldRestoreScroll = parseInt(
      window.sessionStorage.getItem(RESTORE_SCROLL_KEY) ?? "0",
    );
    if (shouldRestoreScroll === 0) {
      window.sessionStorage.setItem(RESTORE_SCROLL_KEY, "1");
    }
  });
</script>

<Layout>
  <div class="container">
    <div class="nav-container">
      <p class="prev" style={prevImageSrc == null ? "visibility: hidden" : ""}>
        <a href={prevImageHref}>[<<]</a>
      </p>
      <p class="prev"><a href={randomImageHref}>[**]</a></p>
      <p class="prev" style={nextImageSrc == null ? "visibility: hidden" : ""}>
        <a href={nextImageHref}>[>>]</a>
      </p>
    </div>
    <img src={imageSrc} />
  </div>
</Layout>

<style>
  .container {
    display: flex;
    flex-direction: column;
    gap: 24px;
    align-items: center;
    justify-content: center;
    padding-bottom: 72px;
    height: 70vh;
  }

  .nav-container {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    width: 400px;
  }
  
  p {
    font-family: bold;
  }

  img {
    height: 100%;
  }

  @media only screen and (max-width: 700px) {
    .container {
      height: auto;
    }

    img {
      max-width: 100%;
      height: auto;
    }

    .nav-container {
      width: 80%;
    }
  }
</style>

---
import FooteredLayout from "../layouts/FooteredLayout.astro";
import Hero from "../components/Hero.astro";
import Spacer from "../components/Spacer.astro";
import PhotoLog from "../components/PhotoLog.astro";
---

<FooteredLayout>
  <Hero />
  <Spacer />
  <PhotoLog />
</FooteredLayout>

<script>
  // https://stackoverflow.com/questions/76888215/open-link-in-system-browser-instead-of-in-app-browser

  const isInstagram = () => /(Instagram)/.test(navigator.userAgent);
  const isIOS = () => /(iPhone|iPad|iPod)/.test(navigator.userAgent);
  const isAndroid = () => /(Android)/.test(navigator.userAgent);

  const wasRedirected = () =>
    new URL(window.location.href).searchParams.get("redirected") === "true";

  const redirectURL = () => {
    if (wasRedirected()) return;

    if (isInstagram()) {
      const withoutPrefix = window.location.href.substring(
        window.location.href.indexOf("://") + 3,
      );
      if (isIOS()) {
        const iosURL = `x-safari-https://${withoutPrefix}?redirected=true`;
        window.location.href = iosURL;
      } else if (isAndroid()) {
        const androidURL = `intent://${withoutPrefix}?redirected=true#Intent;scheme=https;package=com.android.chrome;end`;
        window.location.href = androidURL;
      }
    }
  };

  redirectURL();
</script>

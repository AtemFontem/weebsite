---
// src/pages/about.astro
import FooteredLayout from "../layouts/FooteredLayout.astro";
---

<FooteredLayout title="about">
  <main class="about-page">
    <h1>about</h1>

    <section>
      <p>
        <span class="title-word full">full</span>
        <span class="title-word wash">wash</span>
        <span class="title-word is">and</span>
        <span class="title-word set">set</span>
        was created by <strong><a href="mailto:atemfontem1@gmail.com" class="clickable-link">atem fontem</a></strong> in 2026.
        <br><br>
        thank you <strong><span class="popup-word" data-popup="alina" tabindex="0" role="button" aria-label="show alina's tree">alina</span></strong> and <strong><span class="popup-word" data-popup="aymen" tabindex="0" role="button" aria-label="show aymen's tree">aymen</span></strong> for the{' '}
        <strong><a href="https://alina.nikitina.us/" class="clickable-link">love</a></strong>{' '}
        and{' '}
        <strong><a href="https://aymen.zip/" class="clickable-link">support</a></strong>.
      </p>
    </section>
  </main>

  <div class="popup-layer" id="popup-alina" aria-hidden="true">
    <div class="popup-card">
      <img src="/site-images/alinas%20tree.JPG" alt="alina's tree" />
      <p class="popup-caption">alina's tree (san francisco, ca)</p>
    </div>
  </div>

  <div class="popup-layer" id="popup-aymen" aria-hidden="true">
    <div class="popup-card">
      <img src="/site-images/aymens%20tree.JPG" alt="aymen's tree" />
      <p class="popup-caption">aymen's tree (new york city, ny)</p>
    </div>
  </div>
</FooteredLayout>

<style is:global>
  .about-page {
    max-width: 700px;
    margin: 0 auto;
    padding: 0 16px;
    min-height: calc(100vh - 260px);
    display: flex;
    flex-direction: column;
  }

  .about-page h1 {
    font-size: 32px;
    margin-bottom: 16px;
    text-align: left;
  }

  .about-page h2 {
    font-size: 20px;
    margin-top: 32px;
    margin-bottom: 12px;
    border-bottom: 1px solid #eee;
    padding-bottom: 8px;
  }

  .about-page p {
    line-height: 1.6;
    margin-bottom: 12px;
  }

  .about-page ul {
    list-style: none;
    padding: 0;
  }

  .about-page ul li {
    padding: 6px 0;
    border-bottom: 1px solid #f0f0f0;
  }

  .title-word {
    font-weight: bold;
    margin-right: 0.25em;
    text-decoration: none;
  }

  .title-word.full { color: #e6b800; }
  .title-word.wash { color: #0003b6; }
  .title-word.is   { color: #ff0000; }
  .title-word.set  { color: #800080; }

  .clickable-link,
  .popup-word {
    color: var(--link, #c50e0e);
    font-weight: bold;
    cursor: pointer;
    text-decoration: underline dotted currentColor;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: text-decoration-style 0.15s ease;
  }

  .clickable-link:hover,
  .popup-word:hover,
  .popup-word:focus-visible,
  .popup-word.active {
    text-decoration: underline solid currentColor;
  }

  .popup-word {
    position: relative;
    outline: none;
    -webkit-tap-highlight-color: transparent;
    display: inline-block;
  }

  @media (hover: none), (max-width: 700px) {
    .popup-word::before {
      content: "";
      position: absolute;
      top: -18px;
      bottom: -18px;
      left: -14px;
      right: -14px;
      z-index: 1;
    }
  }

  /* ============================================================
     POPUP LAYER
     The layer is always anchored at the CENTER of the word.
     The card scales up from that anchor:
       - opening downward → transform-origin: top center
       - opening upward   → transform-origin: bottom center
     When the card would overflow a screen edge, JS sets a
     CSS variable (--popup-shift-x) that slides the card
     horizontally, but the anchor stays at the word's center,
     so the animation still grows from the word.
     ============================================================ */
  .popup-layer {
    position: fixed;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    z-index: 1000;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;

    /* Default shift is 0; JS overrides per-open */
    --popup-shift-x: 0px;
  }

  .popup-layer.visible {
    opacity: 1;
    pointer-events: auto;
  }

  .popup-card {
    position: absolute;
    top: 0;
    left: 0;
    width: 260px;
    max-width: 82vw;
    background: #fffad3;
    border: 1px solid #e5e5e5;
    border-radius: 10px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.18);
    padding: 10px 10px 8px;
    box-sizing: border-box;

    transform:
      translate(calc(-50% + var(--popup-shift-x)), -8px)
      scale(0.15);
    transform-origin: top center;
    opacity: 0;
    transition:
      transform 0.45s cubic-bezier(0.22, 1.05, 0.36, 1),
      opacity 0.3s ease;
  }

  .popup-layer.visible .popup-card {
    transform:
      translate(calc(-50% + var(--popup-shift-x)), 12px)
      scale(1);
    opacity: 1;
  }

  /* Opens upward — scales from the bottom-center of the card,
     which is pinned to the word's center */
  .popup-layer.flip-up .popup-card {
    transform:
      translate(calc(-50% + var(--popup-shift-x)), calc(-100% - 12px))
      scale(0.15);
    transform-origin: bottom center;
  }

  .popup-layer.flip-up.visible .popup-card {
    transform:
      translate(calc(-50% + var(--popup-shift-x)), calc(-100% - 12px))
      scale(1);
    opacity: 1;
  }

  .popup-card img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 6px;
    object-fit: cover;
  }

  .popup-caption {
    margin: 8px 0 0 0;
    font-size: 12px;
    color: #666;
    text-align: center;
    font-style: italic;
  }
</style>

<script is:inline>
  (function () {
    var activeLayer = null;
    var activeWord = null;

    function getLayer(name) {
      return document.getElementById('popup-' + name);
    }

    function positionLayer(layer, word) {
      var rect = word.getBoundingClientRect();
      var card = layer.querySelector('.popup-card');
      if (!card) return;

      // Anchor stays at the word's CENTER, always
      var anchorX = rect.left + rect.width / 2;
      var anchorY = rect.bottom;

      layer.style.left = anchorX + 'px';
      layer.style.top = anchorY + 'px';

      layer.classList.remove('flip-up');

      // Reset horizontal shift before measuring
      layer.style.setProperty('--popup-shift-x', '0px');

      var cardWidth = card.offsetWidth || 260;
      var cardHeight = card.offsetHeight || 220;

      // Vertical flip: if there isn't enough room below, open upward
      var spaceBelow = window.innerHeight - anchorY;
      if (spaceBelow < cardHeight + 24) {
        layer.classList.add('flip-up');
      }

      // Horizontal overflow: keep the anchor at the word's center,
      // but push the card sideways so it stays on screen.
      var halfW = cardWidth / 2;
      var edgePadding = 8;
      var shift = 0;

      if (anchorX - halfW < edgePadding) {
        // Card would overflow the left edge — push it right
        shift = edgePadding - (anchorX - halfW);
      } else if (anchorX + halfW > window.innerWidth - edgePadding) {
        // Card would overflow the right edge — push it left
        shift = (window.innerWidth - edgePadding) - (anchorX + halfW);
      }

      if (shift !== 0) {
        layer.style.setProperty('--popup-shift-x', shift + 'px');
      }
    }

    function closePopup() {
      if (!activeLayer) return;
      activeLayer.classList.remove('visible');
      activeLayer.setAttribute('aria-hidden', 'true');
      if (activeWord) activeWord.classList.remove('active');
      activeLayer = null;
      activeWord = null;
    }

    function openPopup(word) {
      var name = word.getAttribute('data-popup');
      var layer = getLayer(name);
      if (!layer) return;

      if (activeLayer && activeLayer !== layer) {
        closePopup();
      }

      activeWord = word;
      activeLayer = layer;

      layer.classList.add('visible');
      layer.setAttribute('aria-hidden', 'false');
      positionLayer(layer, word);
      word.classList.add('active');
    }

    function togglePopup(word) {
      var name = word.getAttribute('data-popup');
      var layer = getLayer(name);
      if (activeLayer === layer) {
        closePopup();
      } else {
        openPopup(word);
      }
    }

    function initAboutPopups() {
      activeLayer = null;
      activeWord = null;

      var words = document.querySelectorAll('.popup-word');
      if (!words.length) return;

      words.forEach(function (word) {
        if (word.dataset.popupBound === 'true') return;
        word.dataset.popupBound = 'true';

        word.addEventListener('mouseenter', function () {
          openPopup(word);
        });

        word.addEventListener('mouseleave', function () {
          setTimeout(function () {
            if (activeWord === word) closePopup();
          }, 120);
        });

        word.addEventListener('click', function (e) {
          e.preventDefault();
          togglePopup(word);
        });

        word.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            togglePopup(word);
          } else if (e.key === 'Escape') {
            closePopup();
          }
        });
      });
    }

    if (!window.__aboutPopupGlobalBound) {
      window.__aboutPopupGlobalBound = true;

      window.addEventListener('resize', function () {
        if (activeLayer && activeWord) {
          positionLayer(activeLayer, activeWord);
        }
      });

      window.addEventListener('scroll', function () {
        if (activeLayer && activeWord) {
          positionLayer(activeLayer, activeWord);
        }
      }, { passive: true });

      document.addEventListener('click', function (e) {
        if (!activeLayer) return;
        if (e.target.closest('.popup-word')) return;
        if (e.target.closest('.popup-layer')) return;
        closePopup();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAboutPopups);
    } else {
      initAboutPopups();
    }

    document.addEventListener('astro:page-load', function () {
      setTimeout(initAboutPopups, 0);
    });
  })();
</script>
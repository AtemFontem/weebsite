---
// src/pages/about.astro
import FooteredLayout from "../layouts/FooteredLayout.astro";
---

<FooteredLayout title="about">
  <main class="about-page">
    <h1>about</h1>

    <section>
      <p>
        full wash and set was created by <strong><a href="mailto:atemfontem1@gmail.com">atem fontem</a></strong> in 2026.
        <br><br>
        thank you <strong><a href="https://alina.nikitina.us/">alina</a></strong> and <strong><a href="https://aymen.zip/">aymen</a></strong> for the{' '}
        <span class="popup-word" data-popup="love" tabindex="0" role="button" aria-label="show alina's tree">love</span>{' '}
        and{' '}
        <span class="popup-word" data-popup="support" tabindex="0" role="button" aria-label="show aymen's tree">support</span>.
      </p>
    </section>
  </main>

  <div class="popup-layer" id="popup-love" aria-hidden="true">
    <div class="popup-card">
      <img src="/site-images/alinas%20tree.JPG" alt="alina's tree" />
      <p class="popup-caption">alina's tree (san francisco, ca)</p>
    </div>
  </div>

  <div class="popup-layer" id="popup-support" aria-hidden="true">
    <div class="popup-card">
      <img src="/site-images/aymens%20tree.JPG" alt="aymen's tree" />
      <p class="popup-caption">aymen's tree (new york city, ny)</p>
    </div>
  </div>
</FooteredLayout>

<style is:global>
  .about-page {
    max-width: 700px;
    margin: 0 auto;
    padding: 0 16px;
    min-height: calc(100vh - 260px);
    display: flex;
    flex-direction: column;
  }

  .about-page h1 {
    font-size: 32px;
    margin-bottom: 16px;
    text-align: left;
  }

  .about-page h2 {
    font-size: 20px;
    margin-top: 32px;
    margin-bottom: 12px;
    border-bottom: 1px solid #eee;
    padding-bottom: 8px;
  }

  .about-page p {
    line-height: 1.6;
    margin-bottom: 12px;
  }

  .about-page ul {
    list-style: none;
    padding: 0;
  }

  .about-page ul li {
    padding: 6px 0;
    border-bottom: 1px solid #f0f0f0;
  }

  .about-page a {
    color: var(--link, #ff0000);
  }

  .about-page a:hover {
    text-decoration: underline;
  }

  .popup-word {
    color: var(--link, #ff0000);
    cursor: pointer;
    position: relative;
    font-weight: bold;
    outline: none;
    -webkit-tap-highlight-color: transparent;
    transition: text-decoration-color 0.15s ease;
    text-decoration: underline transparent;
  }

  .popup-word:hover,
  .popup-word:focus-visible,
  .popup-word.active {
    text-decoration: underline;
    text-decoration-color: currentColor;
  }

  .popup-layer {
    position: fixed;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    z-index: 1000;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .popup-layer.visible {
    opacity: 1;
    pointer-events: auto;
  }

  .popup-card {
    position: absolute;
    top: 0;
    left: 0;
    width: 260px;
    max-width: 82vw;
    background: #ffffff;
    border: 1px solid #e5e5e5;
    border-radius: 10px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.18);
    padding: 10px 10px 8px;
    box-sizing: border-box;

    transform: translate(-50%, -8px) scale(0.15);
    transform-origin: top center;
    opacity: 0;
    transition:
      transform 0.28s cubic-bezier(0.18, 1.2, 0.32, 1),
      opacity 0.2s ease;
  }

  .popup-layer.visible .popup-card {
    transform: translate(-50%, 12px) scale(1);
    opacity: 1;
  }

  .popup-layer.flip-up .popup-card {
    transform: translate(-50%, calc(-100% - 12px)) scale(0.15);
    transform-origin: bottom center;
  }

  .popup-layer.flip-up.visible .popup-card {
    transform: translate(-50%, calc(-100% - 12px)) scale(1);
    opacity: 1;
  }

  .popup-layer.flip-left .popup-card {
    transform: translate(0, 12px) scale(0.15);
    transform-origin: top left;
  }

  .popup-layer.flip-left.visible .popup-card {
    transform: translate(0, 12px) scale(1);
    opacity: 1;
  }

  .popup-layer.flip-right .popup-card {
    transform: translate(-100%, 12px) scale(0.15);
    transform-origin: top right;
  }

  .popup-layer.flip-right.visible .popup-card {
    transform: translate(-100%, 12px) scale(1);
    opacity: 1;
  }

  .popup-layer.flip-up.flip-left .popup-card {
    transform: translate(0, calc(-100% - 12px)) scale(0.15);
    transform-origin: bottom left;
  }

  .popup-layer.flip-up.flip-left.visible .popup-card {
    transform: translate(0, calc(-100% - 12px)) scale(1);
    opacity: 1;
  }

  .popup-layer.flip-up.flip-right .popup-card {
    transform: translate(-100%, calc(-100% - 12px)) scale(0.15);
    transform-origin: bottom right;
  }

  .popup-layer.flip-up.flip-right.visible .popup-card {
    transform: translate(-100%, calc(-100% - 12px)) scale(1);
    opacity: 1;
  }

  .popup-card img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 6px;
    object-fit: cover;
  }

  .popup-caption {
    margin: 8px 0 0 0;
    font-size: 12px;
    color: #666;
    text-align: center;
    font-style: italic;
  }
</style>

<script is:inline>
  (function () {
    // Module-scoped state, reset per page load
    var activeLayer = null;
    var activeWord = null;

    function getLayer(name) {
      return document.getElementById('popup-' + name);
    }

    function positionLayer(layer, word) {
      var rect = word.getBoundingClientRect();
      var card = layer.querySelector('.popup-card');
      if (!card) return;

      var anchorX = rect.left + rect.width / 2;
      var anchorY = rect.bottom;

      layer.style.left = anchorX + 'px';
      layer.style.top = anchorY + 'px';

      layer.classList.remove('flip-up', 'flip-left', 'flip-right');

      var cardWidth = card.offsetWidth || 260;
      var cardHeight = card.offsetHeight || 220;

      var spaceBelow = window.innerHeight - anchorY;
      if (spaceBelow < cardHeight + 24) {
        layer.classList.add('flip-up');
      }

      var halfW = cardWidth / 2;
      if (anchorX - halfW < 8) {
        layer.style.left = rect.left + 'px';
        layer.classList.add('flip-left');
      } else if (anchorX + halfW > window.innerWidth - 8) {
        layer.style.left = rect.right + 'px';
        layer.classList.add('flip-right');
      }
    }

    function closePopup() {
      if (!activeLayer) return;
      activeLayer.classList.remove('visible');
      activeLayer.setAttribute('aria-hidden', 'true');
      if (activeWord) activeWord.classList.remove('active');
      activeLayer = null;
      activeWord = null;
    }

    function openPopup(word) {
      var name = word.getAttribute('data-popup');
      var layer = getLayer(name);
      if (!layer) return;

      if (activeLayer && activeLayer !== layer) {
        closePopup();
      }

      activeWord = word;
      activeLayer = layer;

      layer.classList.add('visible');
      layer.setAttribute('aria-hidden', 'false');
      positionLayer(layer, word);
      word.classList.add('active');
    }

    function togglePopup(word) {
      var name = word.getAttribute('data-popup');
      var layer = getLayer(name);
      if (activeLayer === layer) {
        closePopup();
      } else {
        openPopup(word);
      }
    }

    function initAboutPopups() {
      // Reset state every time the about page mounts
      activeLayer = null;
      activeWord = null;

      var words = document.querySelectorAll('.popup-word');
      if (!words.length) return;

      words.forEach(function (word) {
        // Guard against double-binding on the same element
        if (word.dataset.popupBound === 'true') return;
        word.dataset.popupBound = 'true';

        word.addEventListener('mouseenter', function () {
          openPopup(word);
        });

        word.addEventListener('mouseleave', function () {
          setTimeout(function () {
            if (activeWord === word) closePopup();
          }, 120);
        });

        word.addEventListener('click', function (e) {
          e.preventDefault();
          togglePopup(word);
        });

        word.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            togglePopup(word);
          } else if (e.key === 'Escape') {
            closePopup();
          }
        });
      });
    }

    // Window / document listeners: attach once per full page load, not per navigation
    if (!window.__aboutPopupGlobalBound) {
      window.__aboutPopupGlobalBound = true;

      window.addEventListener('resize', function () {
        if (activeLayer && activeWord) {
          positionLayer(activeLayer, activeWord);
        }
      });

      window.addEventListener('scroll', function () {
        if (activeLayer && activeWord) {
          positionLayer(activeLayer, activeWord);
        }
      }, { passive: true });

      document.addEventListener('click', function (e) {
        if (!activeLayer) return;
        if (e.target.closest('.popup-word')) return;
        if (e.target.closest('.popup-layer')) return;
        closePopup();
      });
    }

    // Bind on initial load and on every Astro navigation
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAboutPopups);
    } else {
      initAboutPopups();
    }

    document.addEventListener('astro:page-load', function () {
      // Defer slightly so Astro finishes swapping the DOM
      setTimeout(initAboutPopups, 0);
    });
  })();
</script>